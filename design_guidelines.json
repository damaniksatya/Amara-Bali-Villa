{
  "theme": "light",
  "archetype": "1_organic_earthy",
  "vibe": "Tropical luxury, Elegant minimalism, Premium hospitality aesthetic, High-end Bali resort feeling",
  "colors": {
    "background_primary": "#FAFAFA",
    "background_secondary": "#F4F1EA",
    "surface": "#FFFFFF",
    "text_primary": "#1A1A1A",
    "text_secondary": "#4A4A4A",
    "accent_primary": "#D4AF37",
    "accent_secondary": "#E6D5C3",
    "border": "#E5E5E5"
  },
  "typography": {
    "heading_font": "Cormorant Garamond",
    "body_font": "Outfit",
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "scale": {
      "h1": "text-5xl sm:text-6xl tracking-tight leading-none",
      "h2": "text-3xl sm:text-4xl tracking-tight leading-none",
      "h3": "text-2xl sm:text-3xl tracking-tight",
      "h4": "text-xl sm:text-2xl",
      "body": "text-base leading-relaxed",
      "label": "text-xs tracking-[0.2em] uppercase"
    }
  },
  "spacing_and_layout": {
    "generous_spacing": true,
    "section_padding": "py-24 sm:py-32",
    "container_max_width": "max-w-7xl mx-auto px-6 sm:px-8",
    "border_radius": "rounded-2xl",
    "shadows": "shadow-[0_8px_30px_rgb(0,0,0,0.04)]",
    "grid_patterns": {
      "bento_marketing": "grid-cols-1 md:grid-cols-12 gap-8"
    }
  },
  "components": {
    "button": "bg-[#1A1A1A] text-white hover:bg-[#D4AF37] hover:text-white transition-colors duration-300 rounded-full px-8 py-3",
    "card": "bg-white rounded-2xl shadow-sm border border-[#E5E5E5] overflow-hidden hover:shadow-md transition-shadow duration-300",
    "navbar": "fixed top-0 w-full z-50 backdrop-blur-xl bg-white/80 border-b border-white/20 transition-all duration-300",
    "hero_overlay": "bg-black/30"
  },
  "motion": {
    "hover_state": "transition-all duration-300 ease-out",
    "image_hover": "hover:scale-105 transition-transform duration-700 ease-out"
  },
