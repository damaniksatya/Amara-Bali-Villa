  "instructions_to_main_agent": [
    "Install required fonts: Cormorant Garamond and Outfit.",
    "Use lucide-react for standard icons.",
    "Navigation bar must be sticky with glassmorphism effect (backdrop-blur-xl bg-white/80) or completely transparent over the hero image depending on scroll position.",
    "Hero image must have an overlay of bg-black/30 to bg-black/50 so the search form is clearly readable.",
    "All buttons must use the accent primary color (#D4AF37) or black (#1A1A1A) with hover states.",
    "Use generous padding for sections (py-24 or py-32).",
    "Images should have rounded-2xl corners to fit the organic/soft aesthetic.",
    "Include data-testid attributes on all interactive elements.",
    "Use Shadcn components for complex interactions like date pickers and dropdowns, but heavily customize them to remove standard Vercel look."
  ]
}